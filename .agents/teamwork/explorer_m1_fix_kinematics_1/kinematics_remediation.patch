-    PLANE_TOLERANCE: 0.001
+    PLANE_TOLERANCE: 0.001,
+    MAX_DELTA_TIME: 0.05
 });
 
 /**
@@ -217,31 +218,46 @@ function clamp2DPlane(entity, tolerance = DEFAULT_KINEMATICS_CONFIG.zTolerance)
  * @param {Array<Object>} [platforms]
  * @param {number} [dt]
  * @param {Object} [config]
+ * @param {number} [prevY] - Pre-integration vertical coordinate. Reconstructed defensively if omitted.
